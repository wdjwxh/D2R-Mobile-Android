<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.d2rm"
    android:versionCode="1"
    android:versionName="0.1-research">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
    <application
        android:debuggable="true"
        android:label="D2R Mobile Research"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
